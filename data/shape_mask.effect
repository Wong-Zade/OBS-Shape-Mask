uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d mask_image;

uniform int    shape_type;
uniform float2 shape_scale;
uniform float2 offset;
uniform float2 uv_size;
uniform float  feather;
uniform float  corner_radius;
uniform float rotation;
uniform bool   mask_invert;
uniform bool   use_source_mask;

uniform bool   border_enabled;
uniform float4 border_color;
uniform int   border_style;
uniform float border_opacity;
uniform float border_dash;
uniform float  border_width;
uniform float  border_glow;
uniform bool   border_pulse;
uniform float  pulse_speed;
uniform float  pulse_amount;
uniform float  time_seconds;

uniform bool   shadow_enabled;
uniform float4 shadow_color;
uniform float2 shadow_offset;
uniform float  shadow_blur;
uniform float  shadow_opacity;
uniform bool  glow_enabled;
uniform float4 glow_color;
uniform float  glow_size;
uniform float  glow_intensity;
uniform bool  glow_pulse;
uniform int   animation;
uniform float animation_speed;
uniform float animation_amount;

sampler_state def_sampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

sampler_state mask_sampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float2 rotate_point(float2 p, float a)
{
	float s = sin(a);
	float c = cos(a);
	return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float2 shape_point(float2 uv, float2 center)
{
	float aspect = uv_size.x / uv_size.y;
	float2 p = uv - center;
	p.x *= aspect;
	return p;
}

float sd_circle(float2 p, float r)
{
	return length(p) - r;
}

float sd_round_rect(float2 p, float2 half_size, float corner)
{
	float c = min(corner, min(half_size.x, half_size.y));
	float2 q = abs(p) - (half_size - c);
	return length(max(q, float2(0.0, 0.0))) - c;
}

float sd_box(float2 p, float2 b)
{
	float2 q = abs(p) - b;
	return length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0);
}

float shape_distance(float2 uv, float2 center, float2 scale, float corner)
{
	float2 p = shape_point(uv, center);
	p = rotate_point(p, -rotation * 0.01745329252);
	if (shape_type == 0)
		return sd_circle(p, 0.45 * min(scale.x, scale.y));
	if (shape_type == 1)
		return sd_round_rect(p, float2(0.42, 0.32) * scale, corner * min(scale.x, scale.y));
	return sd_box(p, float2(0.42, 0.32) * scale);
}

float4 PSShapeMask(VertData v_in) : TARGET
{
	float4 src = image.Sample(def_sampler, v_in.uv);
	float t = time_seconds * animation_speed;
	float anim = sin(t);
	float2 center = float2(0.5,0.5) + offset;
	float2 animated_offset = float2(0.0,0.0);
	if (animation == 4) animated_offset.y = abs(anim)*animation_amount*0.03;
	if (animation == 5) animated_offset = float2(sin(t*7.0),cos(t*6.0))*animation_amount*0.01;
	float anim_scale = 1.0;
	if (animation == 1) anim_scale += anim*animation_amount*0.15;
	if (animation == 2) anim_scale += (anim*0.5+0.5)*animation_amount*0.12;
	if (animation == 6) anim_scale += anim*animation_amount*0.20;
	float2 render_scale = shape_scale * anim_scale;
	float d=0.0;
	float fill_alpha;
	if (use_source_mask) fill_alpha = mask_image.Sample(mask_sampler,v_in.uv).a;
	else { d=shape_distance(v_in.uv,center+animated_offset,render_scale,corner_radius); fill_alpha=saturate(1.0-smoothstep(0.0,max(feather,0.001),d)); }
	if (mask_invert) fill_alpha=1.0-fill_alpha;
	float4 result=float4(src.rgb,src.a*saturate(fill_alpha));
	if (shadow_enabled) {
		float shadow_alpha;
		if (use_source_mask) shadow_alpha=mask_image.Sample(mask_sampler,v_in.uv-shadow_offset).a;
		else { float sd=shape_distance(v_in.uv,center+shadow_offset+animated_offset,render_scale,corner_radius); shadow_alpha=saturate(1.0-smoothstep(0.0,max(shadow_blur,0.001),sd)); }
		if(mask_invert) shadow_alpha=1.0-shadow_alpha;
		shadow_alpha*=shadow_opacity*shadow_color.a;
		float na=shadow_alpha+result.a*(1.0-shadow_alpha);
		float3 nr=shadow_color.rgb*shadow_alpha+result.rgb*result.a*(1.0-shadow_alpha);
		if(na>0.0001) nr/=na; result=float4(nr,na);
	}
	if(border_enabled && !use_source_mask) {
		float width=max(border_width,0.0005);
		if(border_pulse) width*=1.0+pulse_amount*sin(time_seconds*pulse_speed);
		float ring=1.0-smoothstep(0.0,width,abs(d));
		float4 bc=border_color;
		if(border_style==1) { float2 bp=shape_point(v_in.uv,center); float a=atan2(bp.y,bp.x); ring*=step(0.5,frac((a+3.14159265)*border_dash/6.2831853)); }
		float eg=(1.0-smoothstep(width,width*4.0,max(d,0.0)))*border_glow;
		float ba=saturate(max(ring,eg*(1.0-ring)))*border_opacity*bc.a;
		float na=ba+result.a*(1.0-ba); float3 nr=bc.rgb*ba+result.rgb*result.a*(1.0-ba);
		if(na>0.0001) nr/=na; result=float4(nr,na);
	}
	if(glow_enabled && !use_source_mask) {
		float ga=(1.0-smoothstep(0.0,max(glow_size,0.001),max(d,0.0)))*glow_intensity;
		if(glow_pulse) ga*=0.75+0.25*(sin(t)+1.0);
		ga*=glow_color.a;
		float na=saturate(max(result.a,ga)); float3 nr=glow_color.rgb*ga+result.rgb*result.a*(1.0-ga);
		if(na>0.0001) nr/=na; result=float4(nr,na);
	}
	return result;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSShapeMask(v_in);
	}
}
